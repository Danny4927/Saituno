{
  "name": "saituno",
  "version": "0.1.0",
  "private": true,
  "description": "A simple, free tuner for guitar, bass and ukulele.",
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "build:production": "ng build --configuration production",
    "build:pages": "ng build --configuration production --base-href /Saituno/",
    "build:native": "ng build --configuration production --base-href /",
    "lint": "prettier --check \"src/**/*.{ts,html,scss,json}\" \"public/worklets/**/*.js\" \"*.{json,js,ts,mts}\"",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\" \"public/worklets/**/*.js\" \"*.{json,js,ts,mts}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "native:add:android": "cap add android",
    "native:add:ios": "cap add ios",
    "native:sync": "cap sync"
  },
  "dependencies": {
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/forms": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@angular/router": "22.2.6",
    "@angular/service-worker": "22.2.6",
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@ionic/angular": "9.0.11",
    "ionicons": "8.0.13",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.6",
    "@capacitor/cli": "8.6.2",
    "@playwright/test": "1.65.1",
    "@types/node": "26.0.0",
    "prettier": "3.6.2",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.7": true,
    "fsevents@2.3.3": true
  }
}
